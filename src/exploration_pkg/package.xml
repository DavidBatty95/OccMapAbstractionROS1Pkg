<?xml version="1.0"?>
<package format="2">
  <name>exploration_pkg</name>
  <version>0.1.0</version>
  <description>Occupancy-map abstraction and radiation-aware exploration research tools.</description>
  <maintainer email="dwbatty@liverpool.ac.uk">David Batty</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/DavidBatty95/OccMapAbstractionROS1Pkg</url>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-tqdm</exec_depend>
  <!-- Torch/GPyTorch versions are pinned in docker/requirements.txt. -->
  <export/>
</package>
